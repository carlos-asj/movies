generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PROD_DATABASE_URL")
  directUrl = env("PROD_DATABASE_URL_UNPOOLED")
}

model Movie {
  id          Int      @id @default(autoincrement())
  oscarBaseMovieId Int @unique
  title       String
  year        Int
  category    String
  posterPath  String?
  overview    String?
  watched     Boolean  @default(false)
  createdAt   DateTime @default(now())
}